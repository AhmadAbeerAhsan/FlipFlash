<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlipFlash.FlashCardPage.FlashCardEditerView"
             xmlns:viewModels="clr-namespace:FlipFlash.FlashCardPage"
             x:DataType="viewModels:FlashCardEditerViewModel"
             xmlns:tabView="clr-namespace:Syncfusion.Maui.Toolkit.TabView;assembly=Syncfusion.Maui.Toolkit"
             HideSoftInputOnTapped="True"
             Title="CardEditer"
             xmlns:controls="clr-namespace:FlipFlash.Controls"
             xmlns:strings="clr-namespace:FlipFlash.Resources.strings">


    <Grid
            RowDefinitions="auto, auto, *, *, *, auto"
            ColumnDefinitions="*, *"
            RowSpacing="0"
            ColumnSpacing="20"
            Padding="20">
            <Label
                Text="{x:Static strings:AppResources.DIFFICULTY}"
                VerticalOptions="End"
                Margin="11,0,0,0"/>  
            <Picker
                Grid.Row="1"
                Grid.Column="0"
                ItemsSource="{Binding DifficultyLevels}"
                SelectedIndex="{Binding FlashCard.DiffLevel}"
                VerticalOptions="Start">
            </Picker>

            <Label
                Grid.Column="1"
                Text="{x:Static strings:AppResources.STACK}"
                VerticalOptions="Center"
                Margin="11,0,0,0"/>
            <Picker
                Grid.Row="1"
                Grid.Column="1"
                ItemsSource="{Binding CardCollections}"
                ItemDisplayBinding="{Binding Name}"
                SelectedIndex="0"
                VerticalOptions="Center">  
            </Picker>

        <controls:CardContentView
            x:Name="QuesiotnCard"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            CardContent="{Binding FlashCard.Question}"
            Placeholder="{x:Static strings:AppResources.Enter_question_term}"
            TopLeftLabel="{x:Static strings:AppResources.FRONT_SIDE}"
            TopLeftLabelColor="Black"
            TopRightLabel="{x:Static strings:AppResources.Question}"
            TopRightLabelColor="Red"
            MinWidth="{Binding Width, Source={x:Reference QuesiotnCard}}"/>

        <controls:CardContentView
            Grid.Row="3"
            Grid.ColumnSpan="2"
            CardContent="{Binding FlashCard.Answer}"
            Placeholder="{x:Static strings:AppResources.Enter_answer_definition}"
            TopLeftLabel="{x:Static strings:AppResources.BACK_SIDE}"
            TopLeftLabelColor="Black"
            TopRightLabel="{x:Static strings:AppResources.Answer}"
            TopRightLabelColor="Green"/>

        <Button Grid.Row="5" Grid.Column="0" Text="Create/Save" BackgroundColor="#3d6dcc" Clicked="OnSaveButtonClicked"/>
        <Button Grid.Row="5" Grid.Column="1" Text="{x:Static strings:AppResources.Save}"
        BackgroundColor="White"
        BorderWidth="1"
        BorderColor="#3d6dcc"
        TextColor="#3d6dcc"/>
    </Grid>
    
</ContentPage>